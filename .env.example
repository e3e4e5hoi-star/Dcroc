# ── Resend email OTP ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
DCROC_EMAIL_FROM=Dcroc Exchange <no-reply@travian.icu>
# Used to hash one-time codes. Set a long random value in Vercel.
AUTH_SECRET=replace_with_a_long_random_secret

# ── Upstash Redis ─────────────────────────────────────────────────
# Create free instance at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── CoinGecko (optional — free tier works without key) ───────────
# COINGECKO_API_KEY=your_key_if_needed
